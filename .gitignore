# ================================================
# Unreal Engine 4/5 项目 .gitignore
# ================================================

# Visual Studio / 编辑器
.vs/
.vscode/
.idea/
.vsconfig

# Claude 本地配置（含本机绝对路径，不应入库）
.claude/
*.suo
*.user
*.userosscache
*.sln.docstates

# IDE 缓存
*.ipch
*.VC.db
*.VC.opendb

# 编译产物
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
AutomationTool/
.nuget/

# 工程文件（VS / Rider 生成）
*.sln
*.slnx
*.xcodeproj
*.xcworkspace

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 日志与临时文件
*.log
*.tmp
*.tmp_proj
crashpad/

# 平台构建输出
*.apk
*.ipa
*.dll
*.exe
*.pdb
